{
  "name": "sundaytictactoe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:build": "next build",
    "e2e:server": "NODE_ENV=production E2E_SEAM=1 next start -p 3000",
    "e2e:server:worker": "opennextjs-cloudflare build -c wrangler.e2e.jsonc && opennextjs-cloudflare preview -c wrangler.e2e.jsonc -- --port 3000 --var E2E_SEAM:1",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:install:webkit": "playwright install --with-deps webkit",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "probe": "node scripts/probe.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "smoke:features": "node scripts/smoke-features.mjs",
    "port:status": "bash scripts/port-status.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.108.1",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.4",
    "typescript": "^5",
    "undici": "^8.10.2",
    "vitest": "^4.1.11"
  }
}
